{
  "name": "bmw-lex",
  "version": "0.1.7",
  "description": "Lex — BMW Legal AI Agent Platform built on Pi",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <27"
  },
  "bin": {
    "bmw-lex": "bin/lex.js",
    "bmw-lex-web": "bin/lex-web.js",
    "lex": "bin/lex.js",
    "lex-web": "bin/lex-web.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "dist/",
    "web/app/",
    "web/next.config.js",
    "web/package.json",
    "web/tsconfig.json",
    "web/next-env.d.ts",
    "scripts/",
    "logo.mjs",
    "logo.d.mts",
    "metadata/",
    ".lex/agents/",
    ".lex/settings.json",
    ".lex/SYSTEM.md",
    ".lex/themes/",
    "extensions/",
    "prompts/",
    "skills/",
    "knowledge-base/",
    "samples/",
    "AGENTS.md",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "postinstall": "node ./scripts/postinstall.mjs",
    "start:dist": "node ./bin/lex.js"
  },
  "keywords": [
    "pi-package",
    "legal-agent",
    "bmw",
    "contract-review",
    "compliance"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@mariozechner/pi-ai": "^0.67.6",
    "@mariozechner/pi-coding-agent": "^0.67.6",
    "@sinclair/typebox": "^0.34.49",
    "dotenv": "^17.4.2",
    "next": "15.5.15",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^9.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "basic-ftp": "5.3.0",
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "1.19.14",
      "hono": "4.12.14"
    },
    "express": {
      "router": {
        "path-to-regexp": "8.4.2"
      }
    },
    "proxy-agent": {
      "pac-proxy-agent": {
        "get-uri": {
          "basic-ftp": "5.3.0"
        }
      }
    },
    "protobufjs": "7.5.5",
    "minimatch": {
      "brace-expansion": "5.0.5"
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsamirkhon/lex.git"
  },
  "homepage": "https://github.com/itsamirkhon/lex#readme"
}
