# Lex — BMW Legal AI Platform
# Copy to .env and fill in your values.

# Required: Anthropic API key for Claude models
ANTHROPIC_API_KEY=

# Optional: Model selection (defaults to Claude Sonnet if not set)
LEX_MODEL=anthropic/claude-sonnet-4-6

# Optional: Thinking level (off | minimal | low | medium | high | xhigh)
LEX_THINKING=medium

# Optional: Custom home directory (default: ~/.lex)
# LEX_HOME=~/.lex

# Optional: Legal database APIs (web fallback is used if not set)
# EXA_API_KEY=          # Better legal web search via exa.ai
# OTTO_SCHMIDT_API_KEY= # Otto-Schmidt legal database (DE)
# BECK_ONLINE_API_KEY=  # Beck Online legal database (DE)

# Optional: Other LLM providers (passed through to Pi runtime)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Web UI settings
LEX_WEB_PORT=3000
